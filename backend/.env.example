# Copy to .env and `set -a; source .env; set +a` before `npm run dev`, or pass the values on the command line.

# Required
ACCESS_TOKEN=change-me            # shared secret; the TV app and the phone page send it as x-access-token
PUBLIC_URL=http://192.168.0.10:8787  # where phones reach this server (goes into the QR code)

# Local dev only
MODEL_PROVIDER=fixture            # fixture = canned answers, no AWS needed; bedrock = Amazon Nova
PORT=8787
STATE_FILE=./dev-state.json
TIME_SHIFT_MINUTES=0              # run the household on a shifted clock (for testing the departure countdown)

# Amazon Nova on Bedrock (MODEL_PROVIDER=bedrock, and the Lambda)
AWS_REGION=us-east-1
TEXT_MODEL_ID=us.amazon.nova-micro-v1:0
VISION_MODEL_ID=us.amazon.nova-lite-v1:0

# Lambda only
TABLE_NAME=family-hub

# Household
TIMEZONE=Asia/Tokyo
LOCATION_NAME=Tokyo
LATITUDE=35.6895
LONGITUDE=139.6917
FAMILY=Dad,Mom,Ken,Yui
